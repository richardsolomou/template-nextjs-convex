{
  "name": "template-nextjs-convex",
  "version": "0.0.3",
  "private": true,
  "description": "Template for Next.js projects with Convex.",
  "keywords": [],
  "homepage": "https://solomou.dev",
  "bugs": {
    "url": "https://github.com/richardsolomou/template-nextjs-convex/issues",
    "email": "richard@solomou.dev"
  },
  "license": "MIT",
  "author": {
    "name": "Richard Solomou",
    "email": "richard@solomou.dev",
    "url": "https://solomou.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/richardsolomou/template-nextjs-convex"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently \"pnpm dev:web\" \"pnpm dev:convex\"",
    "dev:web": "next dev --turbopack",
    "dev:convex": "convex dev",
    "build": "next build",
    "start": "next start",
    "export": "pnpm build && next export -o _static",
    "check-types": "tsc --noEmit",
    "check": "oxfmt --check . && oxlint --type-aware --deny-warnings .",
    "fix": "oxfmt --write . && oxlint --type-aware --fix .",
    "policy:check": "ras-stack-policy check"
  },
  "dependencies": {
    "@ras-sh/ui": "^0.0.6",
    "convex": "^1.43.0",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "concurrently": "^10.0.4",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "ras-stack": "^0.8.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.15.0"
}
